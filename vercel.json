{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "vakreceptie-site.vercel.app"
        }
      ],
      "destination": "https://vakreceptie.nl/",
      "statusCode": 301
    },
    {
      "source": "/:path*/",
      "has": [
        {
          "type": "host",
          "value": "vakreceptie-site.vercel.app"
        }
      ],
      "destination": "https://vakreceptie.nl/:path*/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vakreceptie-site.vercel.app"
        }
      ],
      "destination": "https://vakreceptie.nl/:path*",
      "statusCode": 301
    }
  ]
}
